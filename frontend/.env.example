VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=https://localkart.in
VITE_APP_NAME=LocalKart
VITE_REVERSE_GEOCODING_PROVIDER=nominatim
# Set to "none" to skip reverse geocoding. Browser GPS still provides lat/lng.
# Development-only local admin shortcut. Production builds ignore these values.
VITE_LOCALKART_ADMIN_EMAIL=admin@example.com
VITE_LOCALKART_ADMIN_PASSWORD_SHA256=sha256-password-hash
