{
  "description": "GitHub Secrets Template - DO NOT COMMIT THIS FILE",
  "repository": "https://github.com/07sharmasantosh2004-hub/Localkart",
  "last_updated": "2024-01-20",
  "status": "⚠️ TEMPLATE ONLY - USE FOR REFERENCE",
  "instructions": "Fill in your actual values below, then add to GitHub Settings → Secrets",

  "secrets": {
    "KEYSTORE_PASSWORD": {
      "description": "Password for Android keystore (release.keystore)",
      "type": "secret",
      "required": true,
      "value": "[YOUR_KEYSTORE_PASSWORD_HERE]",
      "example": "MySecure@Keystore#Pass2024",
      "how_to_get": "Password you created when generating release.keystore",
      "security_note": "Use strong password (25+ characters, mixed case, symbols)"
    },

    "KEYSTORE_ALIAS": {
      "description": "Alias for the signing key",
      "type": "secret",
      "required": true,
      "value": "localkart-key",
      "example": "localkart-key",
      "how_to_get": "Fixed value - do NOT change",
      "security_note": "This is the key alias, not a password"
    },

    "KEYSTORE_ALIAS_PASSWORD": {
      "description": "Password for the specific key",
      "type": "secret",
      "required": true,
      "value": "[YOUR_KEY_PASSWORD_HERE]",
      "example": "MySecure@Keystore#Pass2024",
      "how_to_get": "Usually same as KEYSTORE_PASSWORD",
      "security_note": "Keep this secure, it's your key password"
    },

    "ANDROID_KEYSTORE_B64": {
      "description": "Base64 encoded release.keystore file",
      "type": "secret",
      "required": true,
      "value": "[LONG_BASE64_STRING_HERE]",
      "example": "MIIJrAIBAzCCCXgGCSqGSIb3DQEHBaCC...",
      "how_to_get": "Encode release.keystore file using base64",
      "command_mac": "base64 release.keystore | tr -d '\\n' | pbcopy",
      "command_windows": "$keystore = [Convert]::ToBase64String([IO.File]::ReadAllBytes('release.keystore')); $keystore | Set-Clipboard",
      "security_note": "This is your entire keystore file - keep it secure"
    },

    "PLAY_STORE_SERVICE_ACCOUNT": {
      "description": "Google Play service account JSON key",
      "type": "secret",
      "required": true,
      "value": "[ENTIRE_JSON_CONTENT_HERE]",
      "example": {
        "type": "service_account",
        "project_id": "localkart-12345",
        "private_key_id": "abc123...",
        "private_key": "-----BEGIN PRIVATE KEY-----\\nMIIEvgI...\\n-----END PRIVATE KEY-----\\n",
        "client_email": "localkart-github@localkart-12345.iam.gserviceaccount.com",
        "client_id": "123456789",
        "auth_uri": "https://accounts.google.com/o/oauth2/auth",
        "token_uri": "https://oauth2.googleapis.com/token",
        "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs"
      },
      "how_to_get": "Download JSON key from Google Cloud Console service account",
      "steps": [
        "1. Go to https://console.cloud.google.com",
        "2. Select or create project",
        "3. Enable 'Google Play Android Developer API'",
        "4. Go to 'Service Accounts'",
        "5. Create service account 'localkart-github'",
        "6. Grant role 'Editor'",
        "7. Create JSON key",
        "8. Download and use JSON content"
      ],
      "security_note": "This is your API key - extremely sensitive, keep it secure"
    }
  },

  "variables": {
    "APP_VERSION": {
      "description": "App version for build",
      "type": "variable",
      "required": false,
      "value": "1.0.0",
      "example": "1.0.0",
      "how_to_get": "Semantic version of your app"
    },

    "ANDROID_PACKAGE_NAME": {
      "description": "Android package identifier",
      "type": "variable",
      "required": false,
      "value": "com.localkart.app",
      "example": "com.localkart.app",
      "how_to_get": "Same as appId in capacitor.config.ts"
    },

    "PLAY_STORE_TRACK": {
      "description": "Play Store release track",
      "type": "variable",
      "required": false,
      "value": "internal",
      "example": "internal",
      "options": ["internal", "beta", "production"],
      "how_to_get": "Which track to deploy to (internal for testing)"
    }
  },

  "checklist": {
    "preparation": [
      "[ ] Create release.keystore file (if not exists)",
      "[ ] Save keystore password securely",
      "[ ] Save key password securely",
      "[ ] Encode keystore to base64",
      "[ ] Create Google Play service account",
      "[ ] Download service account JSON"
    ],

    "github_setup": [
      "[ ] Go to GitHub Settings → Secrets and variables → Actions",
      "[ ] Add KEYSTORE_PASSWORD",
      "[ ] Add KEYSTORE_ALIAS",
      "[ ] Add KEYSTORE_ALIAS_PASSWORD",
      "[ ] Add ANDROID_KEYSTORE_B64",
      "[ ] Add PLAY_STORE_SERVICE_ACCOUNT"
    ],

    "verification": [
      "[ ] All 5 secrets visible in GitHub",
      "[ ] Each secret shows 'Updated X ago'",
      "[ ] Push test commit to trigger CI/CD",
      "[ ] Check Actions tab for build logs",
      "[ ] Verify build completes successfully"
    ]
  },

  "security": {
    "do": [
      "✅ Use strong passwords (25+ chars)",
      "✅ Store passwords in password manager",
      "✅ Keep keystore locally only",
      "✅ Rotate secrets periodically",
      "✅ Audit access logs",
      "✅ Delete old secrets when not needed"
    ],

    "dont": [
      "❌ Commit keystore to git",
      "❌ Commit .env files to git",
      "❌ Share secrets via chat/email",
      "❌ Use weak passwords",
      "❌ Write secrets in commits",
      "❌ Hardcode secrets anywhere"
    ]
  },

  "files_to_prepare": {
    "release.keystore": {
      "location": "frontend/android/release.keystore",
      "what": "Binary keystore file for app signing",
      "how_to_create": "keytool -genkey -v -keystore release.keystore -keyalg RSA -keysize 2048 -validity 10000 -alias localkart-key",
      "keep_secure": "NEVER COMMIT TO GIT",
      "backup": "BACKUP LOCALLY AND OFFLINE"
    }
  },

  "next_steps": [
    "1. Create/locate release.keystore file",
    "2. Save keystore and key passwords securely",
    "3. Encode keystore to base64",
    "4. Create Google Play service account",
    "5. Download service account JSON",
    "6. Add all 5 secrets to GitHub",
    "7. Verify secrets are visible",
    "8. Test by pushing a commit",
    "9. Check Actions tab for build results",
    "10. Deploy to Play Store when ready"
  ],

  "useful_links": {
    "github_secrets": "https://docs.github.com/en/actions/security-guides/encrypted-secrets",
    "android_signing": "https://developer.android.com/studio/publish/app-signing",
    "google_play_console": "https://play.google.com/console",
    "google_cloud_console": "https://console.cloud.google.com",
    "service_accounts": "https://cloud.google.com/iam/docs/service-accounts",
    "capacitor_docs": "https://capacitorjs.com/docs"
  },

  "important_notes": [
    "⚠️ This is a TEMPLATE file - DO NOT commit actual secrets to git",
    "⚠️ Replace all [YOUR_XXX_HERE] values with actual values",
    "⚠️ Keep passwords in password manager, not in files",
    "⚠️ Delete this template once you've added secrets to GitHub",
    "⚠️ Rotate secrets at least annually",
    "⚠️ Revoke service accounts no longer in use"
  ]
}
